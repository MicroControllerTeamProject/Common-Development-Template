#!/bin/sh
# Prefix local commit messages with the Jira issue key found in the branch.
# Example: feature/GS-5-sms -> "GS-5: fix SMS timeout"
set -eu

message_file="${1:-}"
[ -n "$message_file" ] && [ -f "$message_file" ] || exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[ -n "$branch" ] || exit 0

case "$branch" in
  feature/*|bugfix/*|fix/*|hotfix/*|task/*) ;;
  *) exit 0 ;;
esac

issue=$(printf '%s\n' "$branch" | grep -Eo '[A-Z][A-Z0-9]+-[1-9][0-9]*' | head -n 1 || true)
[ -n "$issue" ] || exit 0

first_line=$(grep -m1 -v '^[[:space:]]*\(#\|$\)' "$message_file" || true)
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

tmp="${message_file}.jira.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
awk -v issue="$issue" '
  BEGIN { done = 0 }
  {
    if (!done && $0 !~ /^[[:space:]]*(#|$)/) {
      if (index($0, issue) == 0) print issue ": " $0
      else print $0
      done = 1
      next
    }
    print
  }
' "$message_file" > "$tmp"
cat "$tmp" > "$message_file"
