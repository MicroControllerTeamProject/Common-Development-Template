#!/bin/sh
# Globally installed prepare-commit-msg hook for Jira traceability.
# Example: feature/GS-5-fix -> GS-5 Fix the problem (no colon).
set -eu

message_file="${1:-}"
message_source="${2:-}"
[ -n "$message_file" ] && [ -f "$message_file" ] || exit 0

# Preserve messages generated by Git for merges, squashes and amendments.
case "$message_source" in
  merge|squash|commit) exit 0 ;;
esac

# Optional opt-out for repositories not using Jira:
# git config --local common.jira.enabled false
enabled=$(git config --local --bool --get common.jira.enabled 2>/dev/null || true)
[ "$enabled" = "false" ] && exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[ -n "$branch" ] || exit 0

# Original Jira key pattern: [A-Z][A-Z0-9]*-[0-9]+
# Require a branch-name boundary so a partial key cannot be extracted.
issue=$(printf '%s\n' "$branch" |
  grep -Eo '(^|[./_-])[A-Z][A-Z0-9]*-[0-9]+($|[./_-])' |
  head -n 1 |
  sed -E 's@^[./_-]@@; s@[./_-]$@@' || true)
[ -n "$issue" ] || exit 0

temp_file="${message_file}.jira.$$"
trap 'rm -f "$temp_file"' EXIT HUP INT TERM

awk -v issue="$issue" '
  BEGIN { done = 0 }
  {
    if (!done && $0 !~ /^[[:space:]]*(#|$)/) {
      line = $0
      if (line == issue) {
        print line
      } else if (substr(line, 1, length(issue)) == issue) {
        rest = substr(line, length(issue) + 1)
        if (rest ~ /^:[[:space:]]*/) {
          sub(/^:[[:space:]]*/, "", rest)
          print issue " " rest
        } else if (rest ~ /^[[:space:]]+/) {
          sub(/^[[:space:]]+/, "", rest)
          print issue " " rest
        } else {
          print issue " " line
        }
      } else {
        print issue " " line
      }
      done = 1
      next
    }
    print
  }
' "$message_file" > "$temp_file"
cat "$temp_file" > "$message_file"
